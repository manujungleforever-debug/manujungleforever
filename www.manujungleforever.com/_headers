# ─── Seguridad HTTP Headers — Manu Jungle Forever ─────────────────────────────
# Aplicados globalmente por Cloudflare Pages a todas las respuestas

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=0, must-revalidate

# ─── Headers especiales para el panel CMS ────────────────────────────────────
# El panel admin necesita poder cargar el CMS desde unpkg.com (CDN)
/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://unpkg.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://api.github.com https://github.com https://raw.githubusercontent.com https://unpkg.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com https://hiddenjunglecusco-2jc.pages.dev; frame-src 'self' https://github.com; object-src 'none'
  X-Frame-Options: SAMEORIGIN
  Cache-Control: no-cache, no-store, must-revalidate

# ─── Cacheo de archivos de datos JSON del CMS ────────────────────────────────
# Los JSON deben actualizarse siempre que el cliente edite desde el panel
/data/*
  Cache-Control: no-cache, must-revalidate

# ─── Control de caché para HTML ────────────────────────────────────────────────
# Los archivos HTML se deben validar siempre para obtener versión actualizada
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/*/*.html
  Cache-Control: public, max-age=0, must-revalidate
/*/*/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ─── Archivos estáticos con cache largo ───────────────────────────────────────
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=86400
/wp-content/*
  Cache-Control: public, max-age=31536000, immutable
